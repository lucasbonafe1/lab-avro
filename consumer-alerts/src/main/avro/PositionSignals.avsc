{
  "type": "record",
  "name": "PositionSignal",
  "namespace": "pdi.lab.contracts",
  "doc": "Posição GPS de um veículo ou agente na faixa",
  "fields": [
      {"name": "identifier", "type": "string", "doc": "Placa do veículo ou matrícula do agente"},
      {"name": "latitude", "type": "double"},
      {"name": "longitude", "type": "double"},
      {"name": "timestamp", "type": {"type": "long", "logicalType": "timestamp-millis"}},
      {"name": "velocity", "type": ["null", "double"], "default": null, "doc": "km/h; opcional"}
  ]
}